{
  "name": "spacly",
  "private": true,
  "version": "1.0.0",
  "author": "Spacly Core Team",
  "description": "Evidence-bound GenLayer migration acceptance protocol",
  "workspaces": [
    "apps/web",
    "apps/fixtures",
    "packages/gate"
  ],
  "scripts": {
    "dev": "npm -w @spacly/web run dev",
    "build": "npm -w @spacly/web run build && npm -w @spacly/fixtures run build && npm -w @spacly/gate run build",
    "lint": "npm -w @spacly/web run lint",
    "typecheck": "npm -w @spacly/web run typecheck && npm -w @spacly/gate run typecheck",
    "test:web": "npm -w @spacly/web run test",
    "test:gate": "npm -w @spacly/gate run test",
    "mutation:web": "node mutations/frontend/run.mjs",
    "genlayer": "genlayer"
  },
  "devDependencies": {
    "genlayer": "0.39.2"
  }
}